# Database — PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/discipline_app

# Better Auth secret — generate with: openssl rand -base64 32
# Or PowerShell: [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))
BETTER_AUTH_SECRET=replace_with_32_byte_random_secret

# Application URL (no trailing slash)
PUBLIC_APP_URL=http://localhost:5173

# Environment (development | production)
NODE_ENV=development
